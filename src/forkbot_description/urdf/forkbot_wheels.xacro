<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_link">
      <visual>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.06"/>
        </geometry>
        <material name="negro">
          <color rgba="0.08 0.08 0.08 1"/>
        </material>
      </visual>

      <collision>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.06"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.0028" ixy="0" ixz="0"
                 iyy="0.005" iyz="0" izz="0.0028"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} -0.095"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>
</robot>
