<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Mastil vertical del montacargas -->
  <xacro:macro name="forkbot_mast">

    <link name="mast_link">
      <visual>
        <geometry>
          <box size="0.08 0.40 0.62"/>
        </geometry>
        <material name="gris_oscuro">
          <color rgba="0.12 0.12 0.15 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.40 0.62"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="3.0"/>
        <inertia ixx="0.1361" ixy="0" ixz="0"
                 iyy="0.0977" iyz="0" izz="0.0416"/>
      </inertial>
    </link>

    <joint name="mast_fixed_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mast_link"/>
      <origin xyz="0.28 0 0.325"/>
    </joint>

  </xacro:macro>

</robot>
