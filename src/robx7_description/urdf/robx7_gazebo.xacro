<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="RobotHardwareInterface" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
  
    <joint name="base_first_joint">
      <command_interface name="position">
        <param name="min">-${PI}</param>
        <param name="max"> ${PI}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="first_second_joint">
      <command_interface name="position">
        <param name="min">-${PI/2}</param>
        <param name="max"> ${PI/2}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="second_third_joint">
      <command_interface name="position">
        <param name="min">-${PI/2}</param>
        <param name="max"> ${PI/2}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_base_finger_left">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">${gripper_base_width/2-gripper_finger_height}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_base_finger_right">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">${gripper_base_width/2-gripper_finger_height}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find robx7_description)/config/robx7_gazebo_config.yaml</parameters>
    </plugin>
  </gazebo>
</robot>